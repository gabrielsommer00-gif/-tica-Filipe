{
  "entities": {
    "VoucherRegistration": {
      "title": "VoucherRegistration",
      "description": "Cadastro de retirada de voucher por unidade da Óticas Filipe com registro de roteamento WhatsApp ou pendência de contato.",
      "type": "object",
      "properties": {
        "unitId": {
          "type": "string",
          "pattern": "^filipe-[0-9]{2}-[a-z0-9-]+$",
          "minLength": 5,
          "maxLength": 64,
          "description": "Identificador único da unidade selecionada"
        },
        "unitCode": {
          "type": "string",
          "pattern": "^FILIPE-[0-9]{2}$",
          "minLength": 9,
          "maxLength": 16,
          "description": "Código da unidade (ex.: FILIPE-01)"
        },
        "unidade": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "description": "Nome oficial da unidade escolhida"
        },
        "nomeCompleto": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Nome e sobrenome completos do cliente"
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 160,
          "description": "E-mail do cliente"
        },
        "celularWhatsapp": {
          "type": "string",
          "minLength": 10,
          "maxLength": 32,
          "description": "Telefone/WhatsApp do cliente"
        },
        "destinationWhatsapp": {
          "type": "string",
          "pattern": "^(|55[0-9]{10,11})$",
          "maxLength": 20,
          "description": "Número oficial de WhatsApp da unidade de destino, ou vazio se pendente"
        },
        "routingStatus": {
          "type": "string",
          "enum": ["ENCAMINHADO_WHATSAPP", "PENDENTE_DE_CONTATO"],
          "maxLength": 30,
          "description": "Código do status de encaminhamento"
        },
        "routingStatusLabel": {
          "type": "string",
          "enum": ["Encaminhado ao WhatsApp", "PENDENTE DE CONTATO"],
          "maxLength": 40,
          "description": "Rótulo legível do status de encaminhamento"
        },
        "submittedDate": {
          "type": "string",
          "minLength": 8,
          "maxLength": 20,
          "description": "Data local do cadastro (DD/MM/AAAA)"
        },
        "submittedTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 20,
          "description": "Horário local do cadastro (HH:MM:SS)"
        },
        "submittedAtIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 40,
          "description": "Carimbo ISO-8601 do envio"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp do servidor Firestore no momento da gravação"
        },
        "origin": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "Origem da campanha"
        },
        "pageUrl": {
          "type": "string",
          "maxLength": 500,
          "description": "URL da página onde o formulário foi enviado"
        },
        "leadId": {
          "type": "string",
          "maxLength": 100,
          "description": "Identificador de sessão do lead"
        },
        "utmSource": {
          "type": "string",
          "maxLength": 120
        },
        "utmCampaign": {
          "type": "string",
          "maxLength": 120
        },
        "utmMedium": {
          "type": "string",
          "maxLength": 120
        },
        "utmContent": {
          "type": "string",
          "maxLength": 120
        },
        "utmTerm": {
          "type": "string",
          "maxLength": 120
        },
        "utmAdset": {
          "type": "string",
          "maxLength": 120
        },
        "gclid": {
          "type": "string",
          "maxLength": 200
        },
        "fbclid": {
          "type": "string",
          "maxLength": 200
        },
        "canal": {
          "type": "string",
          "maxLength": 100
        },
        "programa": {
          "type": "string",
          "maxLength": 100
        },
        "webhookDispatched": {
          "type": "boolean",
          "description": "Indica se o webhook externo opcional também recebeu o registro"
        }
      },
      "required": [
        "unitId",
        "unitCode",
        "unidade",
        "nomeCompleto",
        "email",
        "celularWhatsapp",
        "destinationWhatsapp",
        "routingStatus",
        "routingStatusLabel",
        "submittedDate",
        "submittedTime",
        "submittedAtIso",
        "createdAt",
        "origin",
        "pageUrl",
        "leadId",
        "utmSource",
        "utmCampaign",
        "utmMedium",
        "utmContent",
        "utmTerm",
        "utmAdset",
        "gclid",
        "fbclid",
        "canal",
        "programa",
        "webhookDispatched"
      ]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Registro de administrador autorizado a consultar cadastros de voucher no painel administrativo.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["admin"],
          "maxLength": 20
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["email", "role", "createdAt"]
    }
  },
  "firestore": {
    "/voucher_registrations/{registrationId}": {
      "schema": {
        "$ref": "#/entities/VoucherRegistration"
      },
      "description": "Armazena todos os cadastros de retirada de voucher com unidade, dados do cliente, data, horário e status do encaminhamento."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Lista de administradores autorizados a ler e gerenciar cadastros de voucher."
    }
  }
}
